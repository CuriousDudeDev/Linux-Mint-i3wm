[global]
    font = Monospace 10
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame
    corner_radius = 8
    
    # This prevents Dunst from trying to run faulty actions on click
    mouse_left_click = close_current
    mouse_middle_click = close_current, close_current
    mouse_right_click = close_all

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 3
